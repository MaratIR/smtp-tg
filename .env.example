BOT_TOKEN=

# Полный image для docker compose (registry/name:tag) — не коммить реальный
BOT_IMAGE=registry.example.com/smtp_message:latest

# В Docker к Mongo на хосте: host.docker.internal вместо 127.0.0.1
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=smtp_message

# Секрет для шифрования email/имён/текстов в Mongo (любая длинная строка)
DATA_ENCRYPTION_KEY=

MAIL_ADDRESS=
MAIL_PASSWORD=
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_USE_SSL=True
SMTP_VALIDATE_CERTS=False

IMAP_HOST=mail.example.com
IMAP_PORT=993

MAIL_POLL_INTERVAL=30
# Автоудаление тредов/текстов сообщений в Mongo старше N часов
MESSAGE_RETENTION_HOURS=72
