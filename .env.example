BOT_TOKEN=

# Optional: Telegram API proxy (bot in restricted network → western nginx → api.telegram.org)
# TELEGRAM_API_BASE=https://tg-proxy.example.com

# Full image ref for docker compose (registry/name:tag) — do not commit a real one
BOT_IMAGE=registry.example.com/smtp_message:latest

# In Docker, use host.docker.internal instead of 127.0.0.1 to reach Mongo on the host
MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=smtp_message

# Secret for encrypting email/names/message texts in Mongo (any long string)
DATA_ENCRYPTION_KEY=

MAIL_ADDRESS=
MAIL_PASSWORD=
SMTP_HOST=mail.example.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_USE_SSL=True
SMTP_VALIDATE_CERTS=False

IMAP_HOST=mail.example.com
IMAP_PORT=993

MAIL_POLL_INTERVAL=30
# Auto-delete message threads in Mongo older than N hours
MESSAGE_RETENTION_HOURS=72
